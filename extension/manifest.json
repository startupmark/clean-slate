{
  "manifest_version": 3,
  "name": "Clean Slate",
  "short_name": "Clean Slate",
  "version": "0.1.0",
  "description": "Take control of your LinkedIn feed. You decide what stays, and the posts you never asked for stop showing up.",
  "default_locale": "en",
  "permissions": ["storage"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Clean Slate",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "web_accessible_resources": [{
    "resources": ["detection.json", "fonts/*.woff2"],
    "matches": ["https://www.linkedin.com/*"]
  }],
  "content_scripts": [{
    "matches": ["https://www.linkedin.com/*"],
    "js": ["engine.js", "runtime.js", "content.js"],
    "css": ["fonts.css", "content.css"],
    "run_at": "document_idle"
  }]
}
